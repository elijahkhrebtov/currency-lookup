NEON_PG_DB_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Only needed to initialize a new account. Or use --secret-file with db:seed.
APP_LOGIN_SECRET=

# Comma-separated browser hostnames/IPs for LAN/proxied development; no scheme or port.
# Example: DEV_ALLOWED_ORIGINS=192.168.1.191
DEV_ALLOWED_ORIGINS=
