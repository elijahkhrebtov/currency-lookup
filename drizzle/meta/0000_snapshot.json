        "pocket_entry_amount": {
          "name": "pocket_entry_amount",
          "value": "\"pocket_budget_entries\".\"amount_cents\" >= 0 and (\"pocket_budget_entries\".\"adjustment\" or \"pocket_budget_entries\".\"amount_cents\" > 0)"
        },
        "pocket_entry_kind": {
          "name": "pocket_entry_kind",
          "value": "\"pocket_budget_entries\".\"kind\" in ('income', 'expense')"
        },
        "pocket_entry_recurrence": {
          "name": "pocket_entry_recurrence",
          "value": "\"pocket_budget_entries\".\"recurrence\" in ('once', 'daily', 'weekly', 'fortnightly', 'monthly')"
        },
        "pocket_entry_adjustment": {
          "name": "pocket_entry_adjustment",
          "value": "not \"pocket_budget_entries\".\"adjustment\" or (\"pocket_budget_entries\".\"recurrence\" = 'once' and not \"pocket_budget_entries\".\"disabled\")"
        }
